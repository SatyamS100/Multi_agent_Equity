# Groq API key — required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model id for synthesis + evaluation (graph.py). Optional — defaults
# to openai/gpt-oss-20b. Override here if Groq deprecates the default again
# (it has happened three times already — see BUGS.md); list current model ids at
# GET https://api.groq.com/openai/v1/models (Authorization: Bearer <key>).
# GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated list of origins allowed to call the backend API.
# Defaults to common local-dev origins if unset (see backend.py).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
