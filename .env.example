# Groq API key — required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model id for synthesis + evaluation (graph.py). Optional — defaults
# to llama-3.1-8b-instant. Override here if Groq deprecates the default;
# see https://console.groq.com/docs/models for current valid ids.
# GROQ_MODEL=llama-3.1-8b-instant

# Comma-separated list of origins allowed to call the backend API.
# Defaults to common local-dev origins if unset (see backend.py).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
